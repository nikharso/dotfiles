#!/usr/bin/env sh
# Print the Hunk theme name matching the current OS appearance.
#
# Hunk can't switch light/dark on its own for custom themes (see
# hunk/config.toml), so git/gitconfig calls this and passes the result to
# `hunk --theme`. Keeps hunk in step with ghostty's
# `theme = light:maxx-mellow-dawn,dark:maxx-mellow` and nvim's auto-dark-mode.

case "$(uname -s)" in
  Darwin)
    # AppleInterfaceStyle only exists while Dark Mode is on.
    if defaults read -g AppleInterfaceStyle >/dev/null 2>&1; then
      echo maxx-mellow
    else
      echo maxx-mellow-dawn
    fi
    ;;
  *)
    case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
      *light*) echo maxx-mellow-dawn ;;
      *)       echo maxx-mellow ;;
    esac
    ;;
esac

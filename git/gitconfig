# Managed by ~/dotfiles — symlinked to ~/.gitconfig by install.sh.

[user]
	name = Maxx
	email = 127284370+maxxkph@users.noreply.github.com

# Hunk (https://hunk.dev) as the default diff viewer.
#
# The theme is picked per invocation by git/hunk-theme so hunk follows the OS
# appearance the way ghostty and nvim do, falling back to the dark palette if
# that script is missing. Palettes live in hunk/config.toml.
#
# Caveat: git controls pager input, so untracked files are NOT synthesized in
# pager mode — run `hunk diff` directly to review brand-new files.
[core]
	pager = hunk pager --theme $($HOME/dotfiles/git/hunk-theme 2>/dev/null || echo maxx-mellow)

[diff]
	tool = hunk

[difftool "hunk"]
	cmd = hunk difftool --theme $($HOME/dotfiles/git/hunk-theme 2>/dev/null || echo maxx-mellow) \"$LOCAL\" \"$REMOTE\" \"$MERGED\"

[difftool]
	prompt = false

[alias]
	lg1 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
